<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2563EB" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1D4ED8" />
            <stroke android:width="2dp" android:color="#93C5FD" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E61E3A8A" />
            <stroke android:width="1.5dp" android:color="#3B82F6" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
