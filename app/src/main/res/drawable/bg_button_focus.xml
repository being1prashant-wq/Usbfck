<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E6222C3D" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1D2533" />
            <stroke android:width="2dp" android:color="#90CAF9" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3131822" />
            <stroke android:width="1dp" android:color="#283244" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
