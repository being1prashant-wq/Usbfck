<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_card_tv_list"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Theme Color Swatch Circle -->
    <View
        android:id="@+id/view_theme_swatch"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/ic_launcher_background" />

    <!-- Title & Description -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_theme_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_theme_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Checkmark Indicator -->
    <ImageView
        android:id="@+id/iv_theme_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="Selected"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone" />

</LinearLayout>
